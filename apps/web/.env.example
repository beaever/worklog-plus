# ============================================
# Supabase (인증/DB)
# ============================================
# 로컬: npx supabase status 로 확인 (URL=http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================
# API (데이터 계층 — Phase 2에서 Supabase로 이전 예정, 그 전까지 Express 사용)
# ============================================
# 백엔드 API 서버 주소 (개발: http://localhost:4000)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ============================================
# 애플리케이션
# ============================================
NODE_ENV=development

# Optional: Analytics, Monitoring
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_SENTRY_DSN=
