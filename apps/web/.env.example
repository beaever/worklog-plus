# ============================================
# Supabase (인증/DB/데이터)
# ============================================
# 로컬: npx supabase status 로 확인 (URL=http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role 키 — 서버(Route Handler)에서만 사용. 절대 클라이언트 노출 금지.
# Vercel 환경변수로만 관리하고 커밋하지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# 애플리케이션
# ============================================
NODE_ENV=development

# Optional: Analytics, Monitoring
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_SENTRY_DSN=
