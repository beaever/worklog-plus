# ============================================
# Supabase (인증/DB/데이터)
# ============================================
# 로컬: npx supabase status 로 확인 (URL=http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role 키 — 서버(Route Handler)에서만 사용. 절대 클라이언트 노출 금지.
# Vercel 환경변수로만 관리하고 커밋하지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# 애플리케이션
# ============================================
NODE_ENV=development

# ============================================
# 에러 모니터링 (Sentry) — 전부 선택값
# 비워두면 초기화를 건너뛰므로 로컬에서는 설정하지 않아도 된다.
# ============================================
# 클라이언트/서버용 DSN (같은 값이지만 노출 범위가 달라 분리)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# 소스맵 업로드용. 없으면 빌드는 통과하고 스택만 난독화된 채 남는다.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Vercel Analytics는 별도 키가 없다 — Vercel 대시보드에서 켜기만 하면 된다.
