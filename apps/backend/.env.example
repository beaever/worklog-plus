# ============================================
# Supabase 데이터베이스 연결
# ============================================

# Transaction Mode Pooler URL (런타임 쿼리용, 포트 6543)
# Supabase 대시보드 → Settings → Database → Connection pooling → Transaction mode
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres"

# 마이그레이션용 Direct URL (Session Mode Pooler, 포트 5432)
# db.PROJECT_REF.supabase.co:5432 는 IPv6 전용이라 IPv4 환경에서 연결 불가
# → Pooler session mode (5432)로 대체 사용 (DDL 지원)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# ============================================
# JWT 설정
# ============================================

# JWT 시크릿 키 (프로덕션에서는 반드시 변경하세요!)
# openssl rand -hex 32 로 생성 권장
JWT_ACCESS_SECRET="your-super-secret-access-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"

# JWT 토큰 만료 시간
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================
# 서버 설정
# ============================================

# 서버 포트
PORT=8080

# 실행 환경 (development, production, test)
NODE_ENV="development"

# CORS 허용 도메인 (프론트엔드 URL)
CORS_ORIGIN="http://localhost:3000"

# 로그 레벨 (error, warn, info, debug)
LOG_LEVEL="info"
